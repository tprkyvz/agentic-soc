# Agentic SOC – Ortam Konfigürasyonu
# Bu dosyayı .env olarak kopyalayıp değerlerini düzenle:
#   cp .env.example .env

# Ollama ayarları
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Log ayarları
LOG_LEVEL=INFO

# Lab ayarları
SSH_CONTAINER_NAME=victim_ssh_server
SSH_LOG_FILTER_KEYWORDS=sshd,failed,invalid,authentication
WEB_CONTAINER_NAME=victim_web_server

# Pipeline ayarları – SSH
# Kaç başarısız girişim = şüpheli olay?
TRIAGE_SUSPICIOUS_THRESHOLD=5
# Kaç başarısız girişim = kesin saldırı?
TRIAGE_MALICIOUS_THRESHOLD=20
# Zaman penceresi (saniye) - bu süre içindeki olaylar gruplanır
TRIAGE_TIME_WINDOW_SECONDS=60

# Pipeline ayarları – Web (SQLi/XSS)
# Kaç SQLi/XSS imzası = şüpheli olay?
TRIAGE_WEB_SUSPICIOUS_THRESHOLD=1
# Kaç SQLi/XSS imzası = kesin saldırı?
TRIAGE_WEB_MALICIOUS_THRESHOLD=3
